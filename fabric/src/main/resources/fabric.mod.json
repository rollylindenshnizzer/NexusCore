{
  "schemaVersion": 1,
  "id": "nexuscore",
  "version": "${version}",
  "name": "NexusCore",
  "description": "A simple utility/library mod for use in rollylindenshnizzer's mods.",
  "authors": [
    "rollylindenshnizzer"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/nexuscore/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.rollylindenshnizzer.nexuscore.fabric.NexusCoreFabric"
    ],
    "client": [
      "io.github.rollylindenshnizzer.nexuscore.fabric.client.NexusCoreFabricClient"
    ]
  },
  "mixins": [
    "nexuscore.mixins.json",
    "nexuscore.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "architectury": ">=13.0.11",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}
